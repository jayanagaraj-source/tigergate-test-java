<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deliberately insecure Maven manifest for SCA / SBOM scanner validation.
  Every dependency below is pinned to a version with at least one well-known
  published CVE. See EXPECTED_FINDINGS.md for the ground-truth list.
  DO NOT copy these versions into a real project.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>test</groupId>
  <artifactId>tigergate-test-java</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>tigergate-test-java</name>
  <description>Security-scanner validation fixture (SCA, SAST, secrets, IaC, SBOM)</description>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- CVE-2021-44228 Log4Shell (JNDI lookup RCE), CVE-2021-45046, CVE-2021-45105 -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.14.1</version> <!-- FINDING: SCA-001 CVE-2021-44228 log4j-core-log4shell (CVE-2021-44228 Log4Shell (JNDI lookup RCE), CVE-2021-45046, CVE-2021-45105) -->
    </dependency>

    <!-- CVE-2019-12384, CVE-2019-14379, CVE-2020-36518 (polymorphic deserialization) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.9.8</version> <!-- FINDING: SCA-002 CVE-2019-12384 jackson-databind-polymorphic-deser (CVE-2019-12384, CVE-2019-14379, CVE-2020-36518 (polymorphic deserialization)) -->
    </dependency>

    <!-- CVE-2015-6420 / classic InvokerTransformer deserialization gadget chain -->
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
      <version>3.2.1</version> <!-- FINDING: SCA-003 CVE-2015-6420 commons-collections-gadget-chain (CVE-2015-6420 / classic InvokerTransformer deserialization gadget chain) -->
    </dependency>

    <!-- CVE-2022-1471 (unsafe constructor deserialization RCE) -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>1.29</version> <!-- FINDING: SCA-004 CVE-2022-1471 snakeyaml-unsafe-constructor (CVE-2022-1471 (unsafe constructor deserialization RCE)) -->
    </dependency>

    <!-- CVE-2022-42889 Text4Shell (StringSubstitutor script interpolation) -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>1.9</version> <!-- FINDING: SCA-005 CVE-2022-42889 commons-text-text4shell (CVE-2022-42889 Text4Shell (StringSubstitutor script interpolation)) -->
    </dependency>

    <!-- CVE-2021-29425 (FileNameUtils.normalize path traversal) -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.6</version> <!-- FINDING: SCA-006 CVE-2021-29425 commons-io-path-traversal (CVE-2021-29425 (FileNameUtils.normalize path traversal)) -->
    </dependency>

    <!-- CVE-2016-1000031 (DiskFileItem deserialization RCE) -->
    <dependency>
      <groupId>commons-fileupload</groupId>
      <artifactId>commons-fileupload</artifactId>
      <version>1.3.2</version> <!-- FINDING: SCA-007 CVE-2016-1000031 commons-fileupload-deser (CVE-2016-1000031 (DiskFileItem deserialization RCE)) -->
    </dependency>

    <!-- CVE-2018-10237, CVE-2020-8908 -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>19.0</version> <!-- FINDING: SCA-008 CVE-2018-10237 guava-outdated (CVE-2018-10237, CVE-2020-8908) -->
    </dependency>

    <!-- CVE-2019-10173 and many XStream deserialization CVEs (2020-2021) -->
    <dependency>
      <groupId>com.thoughtworks.xstream</groupId>
      <artifactId>xstream</artifactId>
      <version>1.4.10</version> <!-- FINDING: SCA-009 CVE-2019-10173 xstream-deser (CVE-2019-10173 and many XStream deserialization CVEs (2020-2021)) -->
    </dependency>

    <!-- CVE-2021-42392 (H2 console JNDI RCE), CVE-2022-23221 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>1.4.199</version> <!-- FINDING: SCA-010 CVE-2021-42392 h2-jndi-rce (CVE-2021-42392 (H2 console JNDI RCE), CVE-2022-23221) -->
    </dependency>

    <!-- CVE-2022-22965 Spring4Shell (spring-beans 5.3.0 - 5.3.17) -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-beans</artifactId>
      <version>5.3.17</version> <!-- FINDING: SCA-011 CVE-2022-22965 spring-beans-spring4shell (CVE-2022-22965 Spring4Shell (spring-beans 5.3.0 - 5.3.17)) -->
    </dependency>

    <!-- CVE-2020-13956 (malformed authority URL handling) -->
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpclient</artifactId>
      <version>4.5.2</version> <!-- FINDING: SCA-012 CVE-2020-13956 httpclient-outdated (CVE-2020-13956 (malformed authority URL handling)) -->
    </dependency>

    <!-- CVE-2022-21724 (JDBC URL arbitrary class instantiation) -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.2.5</version> <!-- FINDING: SCA-013 CVE-2022-21724 postgresql-jdbc-url-instantiation (CVE-2022-21724 (JDBC URL arbitrary class instantiation)) -->
    </dependency>

    <!-- CVE-2023-50164 (multipart path traversal) + transitive OGNL CVEs -->
    <dependency>
      <groupId>org.apache.struts</groupId>
      <artifactId>struts2-core</artifactId>
      <version>2.5.30</version> <!-- FINDING: SCA-014 CVE-2023-50164 struts2-core-multipart-traversal (CVE-2023-50164 (multipart path traversal) + transitive OGNL CVEs) -->
    </dependency>

    <!-- CVE-2020-15250 (TemporaryFolder info disclosure). TEST scope: verifies the scanner reports dependency scope correctly. -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.12</version> <!-- FINDING: SCA-015 CVE-2020-15250 junit-temporaryfolder-test-scope (CVE-2020-15250 (TemporaryFolder info disclosure). TEST scope: verifies the scanner reports dependency scope correctly.) -->
      <scope>test</scope>
    </dependency>

    <!-- Not vulnerable by itself: needed so the servlet SAST fixtures compile.
         PROVIDED scope: a scanner should not report this as shipped. -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>4.0.1</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Sources live in src/ and tests/ rather than the Maven default. -->
    <sourceDirectory>src</sourceDirectory>
    <testSourceDirectory>tests</testSourceDirectory>
    <plugins>
      <!-- SBOM: `mvn cyclonedx:makeAggregateBom` writes target/bom.{json,xml} -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>2.7.9</version>
        <configuration>
          <projectType>application</projectType>
          <schemaVersion>1.4</schemaVersion>
          <includeBomSerialNumber>true</includeBomSerialNumber>
          <includeCompileScope>true</includeCompileScope>
          <includeProvidedScope>true</includeProvidedScope>
          <includeRuntimeScope>true</includeRuntimeScope>
          <includeTestScope>true</includeTestScope>
          <outputFormat>all</outputFormat>
          <outputName>bom</outputName>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
